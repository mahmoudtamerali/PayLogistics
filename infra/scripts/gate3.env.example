# Python needed by prove_isolation.py: pip install boto3 "botocore[crt]"  (the [crt] part is needed after `aws login`)
# Easiest: generate it with scripts/make_gate3_env.py (see its header). Or copy to gate3.env and fill it in.
# Never put keys or passwords in this file; it only holds resource names.

# safety guard: the runner refuses to start unless this says eu-west-1
REGION_CHECK=eu-west-1

# check 1
UPLOADS_BUCKET=
QUARANTINE_BUCKET=
ALARM_INFECTED=securecare-scan-infected-file
# EICAR_WAIT=90

# check 2: images to pass the gate (space separated); BAD_IMAGE defaults to python:3.8-slim
REAL_IMAGES="securecare-records:test securecare-scanner:dev"
# BAD_IMAGE=python:3.8-slim

# check 3: task definition families (space separated); LOCAL_IMAGES is for the docker uid proof
TASKDEFS="securecare-records securecare-scanner"
LOCAL_IMAGES="securecare-records:test securecare-scanner:dev"

# checks 4 and 7
VPC_ID=
ALB_NAME=securecare-records
PROBE_LAMBDA=securecare-probe
CLUSTER=securecare

# check 6
DASHBOARD=securecare-overview
# METRIC_NAMESPACE=SecureCare/Scanner
